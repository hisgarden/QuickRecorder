# QuickRecorder Environment Configuration
#
# This file holds NON-SECRET values consumed by the build/notarization
# scripts. The Apple App-Specific Password is NOT stored here -- it lives
# in macOS Keychain via `xcrun notarytool store-credentials`.
#
# One-time setup:
#   ./scripts/buildRelease.sh --setup-keychain
#   (Reads APPLE_ID and APPLE_TEAM_ID below, then prompts for the password
#    and stores the credential bundle in Keychain. Touch ID / passcode
#    gates every subsequent notarization.)

# Apple ID Email Address (non-secret).
APPLE_ID=your-email@example.com

# Apple Team ID -- 10-character alphanumeric. Required for code-sign export.
# Find it at https://developer.apple.com/account under "Membership."
APPLE_TEAM_ID=ABCD1234EF
